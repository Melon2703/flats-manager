# Apply supabase/migrations, create the owner's Auth account, and disable public signups.
# Public URL and publishable key only. Never use a privileged secret here.
# Local `npm run dev` defaults to dummy data with no environment file needed.
# Set this explicitly when exercising the real Supabase integration.
RENTAL_MANAGER_DATA_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
