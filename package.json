{
  "name": "flats-manager",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:demo": "RENTAL_MANAGER_DATA_MODE=demo next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:supabase": "RENTAL_MANAGER_DATA_MODE=supabase playwright test",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:migrate": "supabase migration up",
    "test:configure": "node scripts/local-test-env.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.4",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3"
  }
}
